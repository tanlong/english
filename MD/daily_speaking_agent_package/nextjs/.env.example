# Server-side environment variables. NEVER put this API key in client-side JavaScript.
OPENAI_API_KEY=replace_with_your_server_side_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Audition the voices in your application; 'onyx' is a suggested male-sounding voice.
OPENAI_TTS_VOICE=onyx
