# Get an API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# Daily Speaking: dialogue model and Alex's male-sounding US English voice.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar

# The key enables natural US-English sample audio on demand (OpenAI TTS).
# Anonymous browser identity is not user authentication; keep the app private until login is added.

# Maximum provider requests across all anonymous identities in each process / 15 minutes.
# Invalid or missing values use 600. Configure a shared gateway budget before using multiple instances.
PROVIDER_GLOBAL_LIMIT=600

# SQLite cache for generated MP3 audio and transcription results (Prisma).
# Use a writable persistent volume on hosted deployments.
DATABASE_URL="file:./prisma/cache.db"

# Optional directory for importing MP3 files from the previous disk cache.
# TTS_CACHE_DIR=/absolute/path/to/old-tts-cache

# Optional cloud transcription. Requires the key above and per-recording learner consent.
# Keep false for local practice without paid calls. Add authentication before public deployment.
ENABLE_CLOUD_SPEECH=false

# Tranh luận: text, TXT and SRT analysis uses OPENAI_API_KEY and OPENAI_MODEL above.

# Content Studio (/admin): three DISTINCT random tokens, at least 32 characters each.
# Leave empty to disable access. Never expose these through NEXT_PUBLIC_ variables.
# These role tokens are for a private pilot; per-person SSO is required before a public CMS.
CONTENT_EDITOR_TOKEN=
CONTENT_REVIEWER_TOKEN=
CONTENT_ADMIN_TOKEN=
