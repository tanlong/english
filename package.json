{
  "name": "natural-english",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "cafe:restore-assets": "node scripts/restore-cafe-assets.mjs",
    "cafe:build-art": "node scripts/cafe/build-layered-art.mjs",
    "cafe:review": "node scripts/cafe/build-review.mjs",
    "cafe:export-scenes": "node scripts/cafe/export-scenes.mjs",
    "cafe:build-gray-boo": "node scripts/cafe/build-gray-boo-lake.mjs",
    "cafe:export-gray-boo": "node scripts/cafe/export-gray-boo.mjs",
    "cafe:record-gray-boo": "node scripts/cafe/record-gray-boo-scene.mjs",
    "npc:doctor": "node scripts/npc/doctor.mjs",
    "npc:inspect": "node scripts/npc/pipeline.mjs inspect",
    "npc:prepare-cohort": "node scripts/npc/prepare-cohort.mjs",
    "npc:batch": "node scripts/npc/batch.mjs",
    "npc:report": "node scripts/npc/build-index.mjs",
    "npc:pack": "node scripts/npc/pack-draft.mjs",
    "npc:validate-master": "node scripts/npc/pipeline.mjs validate-master",
    "npc:check-parts": "node scripts/npc/pipeline.mjs check-parts",
    "npc:generate-missing": "node scripts/npc/pipeline.mjs generate-missing",
    "npc:prepare-pilot": "node scripts/npc/prepare-pilot.mjs",
    "npc:preview": "node scripts/npc/build-review.mjs",
    "npc:render": "node scripts/npc/export-pilot.mjs",
    "npc:gif": "node scripts/npc/export-pilot.mjs",
    "npc:qa": "node scripts/npc/pipeline.mjs qa",
    "test:npc": "node --test scripts/npc-pipeline.test.mjs",
    "postinstall": "prisma generate",
    "predev": "npm run cafe:restore-assets && npm run cafe:build-art && npm run db:setup",
    "dev": "next dev",
    "prebuild": "npm run cafe:restore-assets && npm run cafe:build-art && prisma generate",
    "build": "next build",
    "prestart": "npm run db:setup",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "node --experimental-strip-types scripts/prepare-database.mjs && prisma migrate deploy",
    "db:setup": "npm run db:generate && npm run db:migrate && node --experimental-strip-types scripts/import-tts-cache.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test \"scripts/*.test.mjs\"",
    "test:security": "node --experimental-strip-types --test scripts/security.test.mjs scripts/privacy.test.mjs",
    "test:natural-phrases": "node --experimental-strip-types --test scripts/natural-phrases.test.mjs",
    "test:content": "node --experimental-strip-types --test scripts/lesson-content.test.mjs",
    "test:session-plan": "node --experimental-strip-types --test scripts/session-plan.test.mjs",
    "test:learning": "node --experimental-strip-types --test scripts/learning.test.mjs scripts/personalization.test.mjs",
    "test:tts": "node --experimental-strip-types --test scripts/tts.test.mjs",
    "test:speech-score": "node --experimental-strip-types --test scripts/speech-score.test.mjs",
    "test:daily-speaking": "node --experimental-strip-types --test scripts/daily-speaking.test.mjs",
    "test:debate": "node --experimental-strip-types --test scripts/debate.test.mjs scripts/debate-upload.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:baseline": "node --experimental-strip-types --test scripts/baseline.test.mjs scripts/content-admin.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
