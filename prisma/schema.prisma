generator client {
  provider            = "prisma-client"
  output              = "../app/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model TtsAudio {
  key         String   @id
  requestJson String?
  audio       Bytes
  createdAt   DateTime @default(now())
}

model Transcription {
  key       String   @id
  model     String
  language  String
  text      String
  createdAt DateTime @default(now())
}

model Learner {
  id            String            @id
  stateJson     String            @default("{}")
  dismissedJson String            @default("[]")
  topicOffset   Int               @default(0)
  updatedAt     DateTime          @updatedAt
  records       LearningRecord[]
  examples      CoachingExample[]
  cafeConversations CafeConversation[]
  cafeFlashcards CafeFlashcard[]
}

model CafeConversation {
  id          String   @id @default(uuid())
  tenantId    String
  learnerId   String
  activeKey   String?  @unique
  npcId       String
  topicId     String
  level       String
  useAi       Boolean  @default(false)
  status      String   @default("active")
  busyUntil   DateTime @default(now())
  summaryJson String?
  createdAt   DateTime @default(now())
  endedAt     DateTime?
  learner     Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  turns       CafeTurn[]
  flashcards  CafeFlashcard[]
  @@index([tenantId, learnerId, createdAt])
}

model CafeTurn {
  id              String @id @default(uuid())
  conversationId  String
  clientMessageId String
  userText        String
  replyJson       String?
  createdAt       DateTime @default(now())
  conversation    CafeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
}

model CafeFlashcard {
  id               String @id @default(uuid())
  learnerId        String
  conversationId   String
  normalizedPhrase String
  english          String
  vietnamese       String
  createdAt        DateTime @default(now())
  learner          Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  conversation     CafeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@unique([learnerId, normalizedPhrase, conversationId])
}

model CafeConnection {
  id              String @id
  tenantId        String
  provider        String
  model           String
  ciphertext      String
  keyVersion      String
  revision        Int @default(1)
  status          String @default("draft")
  enabled         Boolean @default(false)
  dailyRequests   Int
  userDailyRequests Int
  timeoutMs       Int
  maxOutputTokens Int
  retryAt         DateTime?
  testingUntil    DateTime?
  updatedAt       DateTime @updatedAt
  @@unique([tenantId, provider])
}

model CafeUsage {
  tenantId String
  provider String
  day      String
  subject  String
  requests Int @default(0)
  @@id([tenantId, provider, day, subject])
}

model CafeAudit {
  id        String @id @default(uuid())
  tenantId  String
  provider  String
  actor     String
  action    String
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
}

model LearningRecord {
  learnerId String
  key       String
  kind      String
  topic     String
  completed Boolean  @default(false)
  dataJson  String
  updatedAt DateTime @updatedAt
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@id([learnerId, key])
  @@index([learnerId, updatedAt])
}

model CoachingExample {
  id         String   @id @default(cuid())
  learnerId  String
  english    String
  vietnamese String
  usageVi    String
  approvedAt DateTime @default(now())
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, english])
}

model ContentDocument {
  id            String   @id
  revision      Int      @default(1)
  status        String   @default("draft")
  draftJson     String
  publishedJson String?
  updatedAt     DateTime @updatedAt
}

model ContentAudit {
  id         String   @id @default(cuid())
  documentId String
  revision   Int
  actor      String
  action     String
  dataJson   String
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

model CoreLexicon {
  id        String   @id
  dataJson  String
  createdAt DateTime @default(now())
}
